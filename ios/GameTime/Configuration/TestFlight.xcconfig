// D142 first private friends TestFlight. See docs/FRIENDS_TESTFLIGHT_PLAN.md.
// The production bundle on the isolated P11B backend: challenges on, account
// mode on. Stakes stay simulated and nonredeemable, and the server owns
// admission, the policy allowlist and settlement. The Stripe SDK is still
// linked, and P11B has D144's commitment switch on, so this build turns
// commitments off itself (GAMETIME_CHALLENGE_COMMITMENTS_ENABLED below).
#include "PublicClient.xcconfig"

SUPABASE_URL = https:/$()/lyushhqoednheqwzsmxh.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_aGUhHPloZc3VEqaU2gP4iw_41VXfG8L

GAMETIME_ENV = testflight
// TestFlight App Attest keys are production-only. Account mode doesn't use them.
APP_ATTEST_ENVIRONMENT = production
GAMETIME_CONTEST_MUTATIONS_ENABLED = NO
GAMETIME_CHALLENGE_V1_ENABLED = YES
GAMETIME_PRIVATE_HEALTH_ACCOUNT_MODE = YES
// Legacy Personal creation is off, so it selects no payment provider.
GAMETIME_PERSONAL_SETTLEMENT_MODE = test_only
GAMETIME_STRIPE_RETURN_URL =
// D144 is not part of this build: no "Put money on it", no card setup, no
// commitment in any request. check-beta-candidate.sh --testflight requires NO.
GAMETIME_CHALLENGE_COMMITMENTS_ENABLED = NO
