// settings), then override only the Staging backend below. Debug and Release
// continue to use the historical public client unchanged.
#include "PublicClient.xcconfig"

// The installable Staging product exercises the isolated P11B backend.
SUPABASE_URL = https:/$()/lyushhqoednheqwzsmxh.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_aGUhHPloZc3VEqaU2gP4iw_41VXfG8L

