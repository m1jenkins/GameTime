// Public mobile-client configuration compiled into every installed GameTime
// build. Supabase publishable keys identify a public client; they are not
// privileged credentials and remain protected by Auth plus database RLS.
//
// Never add an sb_secret_ key, service-role JWT, database password, Apple
// private key, or Edge Function secret to this file.
SUPABASE_URL = https:/$()/jrkzdttophnmkxjoyioo.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_lJS21udjGgBWmlGnvsFCDA_Hu8yWhYy

// The published privacy policy, beta terms, and inbox a tester can write to.
// Apple requires reachable policy/terms URLs before a build reaches external
// testers, and rejects an app whose support contact goes nowhere.
//
// Published September 27, 2026 on GitHub Pages (m1jenkins.github.io/GameTime).
// Support inbox: gametime-support@agentmail.to (Agentmail).
// docs/PRIVACY_POLICY.md and docs/BETA_TERMS.md are the source texts.
GAMETIME_PRIVACY_POLICY_URL = https:/$()/m1jenkins.github.io/GameTime/privacy.html
GAMETIME_BETA_TERMS_URL = https:/$()/m1jenkins.github.io/GameTime/beta-terms.html
GAMETIME_SUPPORT_EMAIL = gametime-support@agentmail.to

// Ordinary challenge transport is opt-in for an explicitly selected Beta target.
// This does not enable server admission, real activity, or fixture policies.
// Do not select the historical hosted project above as a Beta target by default.
GAMETIME_CHALLENGE_V1_ENABLED = NO
GAMETIME_PRIVATE_HEALTH_ACCOUNT_MODE = NO
// D144 "Put money on it" (Stripe sandbox commitments). Off unless a build turns
// it on; the app also refuses it outside Debug and Staging.
GAMETIME_CHALLENGE_COMMITMENTS_ENABLED = NO

// HTTPS invitation intake/generation is independent of backend transport.
// No domain is selected. See docs/BETA_INVITATION_LINKS_LOCAL.md for templates.
GAMETIME_INVITATION_HTTPS_ORIGIN = UNCONFIGURED
