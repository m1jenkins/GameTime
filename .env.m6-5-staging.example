# Copy this file to .env.m6-5-staging and fill the values locally.
# The populated file is gitignored. Never commit its contents.

# Reviewed, nonsecret staging identity. It must match
# supabase/staging-project-ref.
SUPABASE_PROJECT_REF=

# Supabase database and test-user credentials.
# Percent-encode URI-reserved characters in the database password.
STAGING_DATABASE_URL=postgresql://postgres:<percent-encoded-password>@db.<project-ref>.supabase.co:5432/postgres
STAGING_PUBLISHABLE_KEY=
STAGING_USER_EMAIL=
STAGING_USER_PASSWORD=
STAGING_USER_ACCESS_TOKEN=
CONFORMANCE_USER_ID=

# Apple identifiers must match the explicit App ID used to sign the
# GameTimeConformance target.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.gametime.conformance

# Generate a fresh value with: openssl rand -hex 32
GAMETIME_ATTEST_CHALLENGE_SECRET=

# Deterministic fixture coordinates.
CONFORMANCE_LATITUDE=41.8781136
CONFORMANCE_LONGITUDE=-87.6297982

# Fill after the device registers so the final database audit can run.
APP_ATTEST_KEY_ID=
