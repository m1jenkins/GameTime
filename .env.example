# Copy to .env.local and fill in. Never commit the filled-in copy.
#
# Sign in with Apple. Obtained from the Apple Developer portal:
#   client_id = the Services ID (web) or the app bundle id (native).
#   secret    = the ES256 JWT you mint from your .p8 key. Rotates every 6 months.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# App Attest verification (used from M3 onward).
# Team id + bundle id form the App ID that Apple binds attestations to.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=

# Apple's App Attest root certificate, PEM, as one value with literal \n or a
# real multi-line value. This is the trust anchor the whole attestation chain
# hangs from, so it is configuration rather than a constant in the source: a
# wrong pinned root either rejects every attestation or accepts a chain Apple
# never issued, and those bytes should be fetched from Apple rather than
# reproduced from memory. The current direct Apple source is:
# https://www.apple.com/certificateauthority/Apple_App_Attestation_Root_CA.pem
#
# Absent, the ingest functions refuse to start, which is the correct failure
# mode: a deployment that cannot verify attestations must not accept snapshots.
APP_ATTEST_ROOT_CA_PEM=

# The app-owned runtime name. Supabase reserves SUPABASE_* secret names, so do
# not rename this to SUPABASE_ENV. Hosted functions refuse to boot if it is
# absent; local tooling may omit it and receives "local".
GAMETIME_ENV=local

# Dedicated HMAC key for the short-lived, account-bound registration challenge.
# Generate at least 32 URL-safe random characters. Local/test can fall back to
# the legacy local JWT secret; staging and production cannot.
GAMETIME_ATTEST_CHALLENGE_SECRET=

# Whether attestations from Apple's *development* App Attest environment are
# accepted. A debug build on a device its owner fully controls produces one, so
# this defaults to true only in local and test, and the ingest function refuses
# to start if it is true while GAMETIME_ENV=production. Staging explicitly sets
# true only for the debug-signed M6.5 conformance target.
# APP_ATTEST_ALLOW_DEVELOPMENT=true

# Local development escape hatch for App Attest. When "true", the ingest
# function accepts a stub assertion so the backend is testable without a
# physical device. MUST be false/unset in any deployed environment; the
# ingest function refuses to start if this is true in staging or production.
ATTEST_DEV_BYPASS=true

# Hosted Supabase supplies SUPABASE_URL, SUPABASE_JWKS, and
# SUPABASE_SECRET_KEYS. The local CLI supplies its legacy JWT/service-role
# variables. GAMETIME_LEGACY_JWT_SECRET is an explicit fallback only for a
# legacy non-local project; do not set it on a project with signing-key JWKS.
# GAMETIME_LEGACY_JWT_SECRET=
