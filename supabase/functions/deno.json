{
  "name": "@gametime/functions",
  "version": "0.0.0",
  "exports": {},
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/testing": "jsr:@std/testing@^1.0.9",
    "@peculiar/x509": "npm:@peculiar/x509@^1.12.3"
  },
  "tasks": {
    "test": "deno test --allow-env",
    "check": "deno check .",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
